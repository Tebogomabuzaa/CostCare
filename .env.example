# ---- Core ----
SECRET_KEY=change-me-to-a-long-random-string
# Local default is SQLite. For Supabase use the Postgres connection string from
# Project Settings -> Database -> Connection string (URI), e.g.
# DATABASE_URL=postgresql+psycopg://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///./costcare.db

# First admin account (created on startup if it does not exist)
ADMIN_EMAIL=admin@costcare.local
ADMIN_PASSWORD=change-me-now

# Token for calling the admin API from scripts: send header  X-Admin-Token: <value>
ADMIN_API_KEY=

# ---- AI search (OpenAI) ----
# Leave blank to use the built-in offline query parser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Google Places API (New) ----
# Enable "Places API (New)" in Google Cloud, restrict the key to that API.
GOOGLE_MAPS_API_KEY=

# Load demo providers/prices on first start (true/false)
SEED_DEMO_DATA=true
